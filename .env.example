# Copy this file to .env and paste your Gemini API key after the equals sign.
GEMINI_API_KEY=your_api_key_here

# Optional: change the local port.
PORT=3000

# Optional: full path to a locally installed FFmpeg executable.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Optional Milestone 7A: Google Cloud Desktop OAuth client for YouTube.
# YOUTUBE_OAUTH_CLIENT_ID=your_desktop_client_id.apps.googleusercontent.com
# YOUTUBE_OAUTH_CLIENT_SECRET=your_desktop_client_secret
# Defaults to http://127.0.0.1:PORT/api/youtube/oauth/callback.
# YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/youtube/oauth/callback

# Optional Milestone 7C.1 AI-assisted channel-style analysis.
# YOUTUBE_STYLE_AI_MODEL=gemini-3.1-flash-lite
# YOUTUBE_STYLE_AI_MAX_INPUT_TOKENS=100000
# YOUTUBE_STYLE_AI_MAX_OUTPUT_TOKENS=6000
# Cost is displayed only when both current paid-tier rates are configured (USD per 1M tokens).
# YOUTUBE_STYLE_AI_INPUT_USD_PER_MILLION=0.25
# YOUTUBE_STYLE_AI_OUTPUT_USD_PER_MILLION=1.50
