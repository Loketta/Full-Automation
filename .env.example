# Copy this file to .env and paste your Gemini API key after the equals sign.
GEMINI_API_KEY=your_api_key_here

# Optional: change the local port.
PORT=3000

# Optional: full path to a locally installed FFmpeg executable.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
