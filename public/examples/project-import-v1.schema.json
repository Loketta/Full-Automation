{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Loketta/Full-Automation/blob/main/public/examples/project-import-v1.schema.json",
  "title": "Lyria Local Studio Project Import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "theme", "tracks"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "theme": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "direction", "prompt"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "direction": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "prompt": { "type": "string", "minLength": 10, "maxLength": 2000 }
        }
      }
    }
  }
}
