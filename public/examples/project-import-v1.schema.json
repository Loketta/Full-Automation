{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Loketta/Full-Automation/blob/main/public/examples/project-import-v1.schema.json",
  "title": "Lyria Local Studio Project Import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "theme", "tracks"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "theme": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "thematicOpening": { "type": "string", "maxLength": 180, "pattern": "^Music for\\s+.+[.!?]$" },
    "genres": { "$ref": "#/$defs/descriptors" },
    "moods": { "$ref": "#/$defs/descriptors" },
    "targetDurationMinutes": { "type": "number", "minimum": 1, "maximum": 1440 },
    "arrangementNotes": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "tracks": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/track" } }
  },
  "$defs": {
    "descriptors": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "direction", "prompt"],
      "properties": {
        "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "direction": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "prompt": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "energy": { "enum": ["high", "moderate", "low"] },
        "tempo": { "type": "object", "additionalProperties": false, "required": ["minBpm"], "properties": { "minBpm": { "type": "number", "minimum": 20, "maximum": 300 }, "maxBpm": { "type": "number", "minimum": 20, "maximum": 300 } } },
        "musicalKey": { "type": "string", "minLength": 1, "maxLength": 40 },
        "position": { "type": "integer", "minimum": 1, "maximum": 100 },
        "arrangementNotes": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
